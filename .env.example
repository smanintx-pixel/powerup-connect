# Copy to .env for local work. On Netlify, set this under
# Site configuration > Environment variables instead. Never commit the real value.
#
# Supabase dashboard > Connect > "Transaction pooler" connection string
# (port 6543). Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.kmrazemqyutovzngojfb:[YOUR-PASSWORD]@[POOLER-HOST-FROM-DASHBOARD]:6543/postgres

# AI host (Nuance Labs video persona). Server only: never put this in client code.
# Leave unset to hide the host from the app.
NUANCE_API_KEY=
# Optional: which face and voice she uses: sam, sonia (default) or mira.
NUANCE_PERSONA_ID=
